.venv/
venv/
env/
ENV/

# Local Streamlit state and user-specific editor files.
.streamlit/
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local test, notebook, and profiling output.
.hypothesis/
.ipynb_checkpoints/
*.prof
*.pstats

.DS_Store
Thumbs.db

*.log
.env
.env.*
!.env.example

# Keep source data and model outputs out of version control by default.
data/raw/
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.parquet
data/processed/**/*.pkl
data/processed/states/
data/processed/transition_balanced/
data/processed/windows/
*.pt
*.pth
*.ckpt
*.onnx

# Local experiment checkpoints and exports.
artifacts/*.pt
artifacts/*.pth
artifacts/*.ckpt
artifacts/*.onnx
artifacts/*.pkl

# Local build and tooling output.
dist/
build/
*.egg-info/

# Temporary copies made while iterating on the Streamlit app.
app/*_backup.py
app/*_before_polish.py
*.bak
*.tmp
*.swp
*~